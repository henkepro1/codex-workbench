{
  "editor.formatOnSave": true,
  "files.exclude": {
    ".ai/exports": true,
    ".ai/logs": true,
    ".ai/raw": true,
    ".ai/screenshots": true,
    ".ai/tmp": true,
    "**/.ai/exports": true,
    "**/.ai/logs": true,
    "**/.ai/raw": true,
    "**/.ai/screenshots": true,
    "**/.ai/tmp": true
  },
  "files.eol": "\n",
  "git.autofetch": true,
  "search.exclude": {
    ".ai/exports": true,
    ".ai/logs": true,
    ".ai/raw": true,
    ".ai/screenshots": true,
    ".ai/tmp": true,
    "**/.ai/exports": true,
    "**/.ai/logs": true,
    "**/.ai/raw": true,
    "**/.ai/screenshots": true,
    "**/.ai/tmp": true
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "workbench.startupEditor": "none"
}
